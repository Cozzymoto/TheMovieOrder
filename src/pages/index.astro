---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Title from '../components/Title.astro';
import { allFranchises, trending } from '../lib/franchise.js';
import { allPosts, fmtDate, isoDate } from '../lib/posts.js';

const total = (await allFranchises()).length;
const hot = await trending();

// Trending cards show their newest film's poster, since that's usually why
// the franchise is trending. If an earlier card already uses that poster
// (MCU and Spider-Man share Brand New Day), fall back to the next newest.
const used = new Set();
const covers = hot.map(f => {
  const newestFirst = f.release.map(id => f.films[id]).filter(m => m.poster)
    .map((m, i) => ({ ...m, i })).sort((a, b) => b.y - a.y || b.i - a.i).map(m => m.poster);
  const pick = newestFirst.find(p => !used.has(p)) || f.poster;
  used.add(pick);
  return pick;
});
const posts = (await allPosts()).slice(0, 3);
---
<Base description="Every film franchise laid out twice — the order they came out, and the order they happen. Find the right watch order in seconds.">
  <section class="hero">
    <div class="wrap">
      <h1>What order do<br>I watch these in?</h1>
      <p>Every franchise, laid out twice — the order they came out, and the order they happen.</p>

      <div class="search" data-search>
        <label class="sr" for="q">Search for a franchise</label>
        <div class="search__field">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input id="q" class="search__input" type="search" autocomplete="off" placeholder="Search for a franchise" role="combobox" aria-controls="results" aria-expanded="false">
          <button class="search__clear" hidden aria-label="Clear search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="results" id="results" role="listbox"></div>
      </div>

      <div class="quick">
        <span>Popular right now:</span>
        {hot.slice(0, 4).map(f => <a href={`/${f.slug}/`}><Title item={f} /></a>)}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <div class="section__head">
        <h2>Trending franchises</h2>
        <a href="/franchises/">See all {total}</a>
      </div>
      <div class="rail">{hot.map((f, i) => <Card f={f} cover={covers[i]} />)}</div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section__head">
          <h2>From the blog</h2>
          <a href="/blog/">All posts</a>
        </div>
        <ul class="posts">
          {posts.map(p => (
            <li><a class="post-link" href={`/blog/${p.slug}/`}>
              <time datetime={isoDate(p.date)}>{fmtDate(p.date)}</time>
              <h3>{p.title}</h3>
              <p>{p.standfirst}</p>
            </a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

</Base>
