---
import Base from '../layouts/Base.astro';
import Poster from '../components/Poster.astro';
import Card from '../components/Card.astro';
import { allFranchises, related, sections, movedCount } from '../lib/franchise.js';
import Title from '../components/Title.astro';
import Aka from '../components/Aka.astro';
import FilmWhere from '../components/FilmWhere.astro';
import StreamingBox from '../components/StreamingBox.astro';
import { watchURL, buyURL, shortTitle, yearSpan, REGIONS, titleIn, allNames } from '../config.js';

export async function getStaticPaths(){
  const all = await allFranchises();
  return all.map(f => ({ params: { slug: f.slug }, props: { f } }));
}
const { f } = Astro.props;
const formatLabel = { 'animated': 'Animated', 'live-action': 'Live-action', 'photoreal': 'Photoreal CGI' };
const relatedGroups = await related(f.slug);
const moved = movedCount(f);
const parts = sections(f);

const modes = [
  { mode: 'release', key: 'release', otherKey: 'chrono', otherName: 'Chronological' },
  { mode: 'chrono',  key: 'chrono',  otherKey: 'release', otherName: 'Release' }
];

// "Zootropolis (Zootopia)" where the UK and US names differ, so both get found.
const [name, ...others] = allNames(f);
const fullName = others.length ? `${name} (${others.join(', ')})` : name;
const description = `The full ${fullName} watch order — all ${f.release.length} films in release order and in-universe chronological order, with where to watch each one.`;

const jsonld = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `${fullName} watch order (release order)`,
  "description": description,
  "numberOfItems": f.release.length,
  "itemListOrder": "https://schema.org/ItemListOrderAscending",
  "itemListElement": f.release.map((id, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": { "@type": "Movie", "name": f.films[id].t, "dateCreated": String(f.films[id].y), ...(allNames(f.films[id]).length > 1 ? { "alternateName": allNames(f.films[id]).slice(1) } : {}) }
  }))
};
---
<Base title={`${fullName} watch order`} description={description} jsonld={jsonld}>
  <div class="wrap">
    <nav class="crumb"><a href="/franchises/">Franchises</a> / <Title item={f} /></nav>

    <header class="path-head">
      <h1><Title item={f} /> watch order</h1>
      <Aka item={f} />
      <p>{f.blurb}</p>
      <div class="path-facts">
        <div><strong>{f.release.length}</strong><span>films</span></div>
        <div><strong>{yearSpan(f)}</strong><span>released</span></div>
        {moved
          ? <div><strong>{moved}</strong><span>films change position</span></div>
          : <div><strong>Same</strong><span>in both orders</span></div>}
        {parts.length > 1 && <div><strong>{parts.length}</strong><span>separate continuities</span></div>}
      </div>
    </header>

    <div id="path" data-mode="release" data-slug={f.slug}>
      <div class="controls">
        <div class="toggle" role="group" aria-label="Watch order">
          <button data-set="release" aria-pressed="true">Release order</button>
          <button data-set="chrono" aria-pressed="false">Chronological order</button>
        </div>
        <div class="progress">
          <span id="progressText">0 of {f.release.length} watched</span>
          <span class="progress__bar"><i style="width:0%"></i></span>
          <button id="resetBtn">Reset</button>
        </div>
      </div>

      {modes.map(list => (
        <div class={`path-set path--${list.mode}`}>
        {parts.map(part => (
        <>
        {part.title && <h2 class="path-group">{part.title} <span>{part.release.length} {part.release.length === 1 ? 'film' : 'films'}</span></h2>}
        {part.note && <p class="path-group__note">{part.note}</p>}
        <ol class="path">
          {part[list.key].map((id, i) => {
            const m = f.films[id];
            const otherPos = part[list.otherKey].indexOf(id) + 1;
            return (
              <li class="row" data-id={id} data-watched="false">
                <div class="row__n">{i + 1}</div>
                <Poster hue={f.hue} label={shortTitle(m.t)} poster={m.poster} size="w154" />
                <div class="row__body">
                  <h3 class="row__t"><Title item={m} /> <span class="row__y">{m.y}</span></h3>
                  <Aka item={m} />
                  {(m.format || m.remake) && (
                    <p class="row__tags">
                      {m.format && <span class={`tag tag--${m.format}`}>{formatLabel[m.format]}</span>}
                      {m.remake && <span class="tag tag--remake">Remake</span>}
                    </p>
                  )}
                  <p class="row__meta">
                    Set {m.set}
                    {otherPos !== i + 1 && <> · <span class="row__moved">{list.otherName} order #{otherPos}</span></>}
                  </p>
                  <FilmWhere slug={f.slug} fid={id} film={m} />
                </div>
                <div class="row__acts">
                  <a class="btn" href={watchURL(titleIn(m, REGIONS[0]))} {...Object.fromEntries(REGIONS.map(r => [`data-href-${r}`, watchURL(titleIn(m, r), r)]))} target="_blank" rel="noopener nofollow sponsored">Where to watch</a>
                  <a class="btn btn--ghost btn--sm" href={buyURL(titleIn(m, REGIONS[0]))} {...Object.fromEntries(REGIONS.map(r => [`data-href-${r}`, buyURL(titleIn(m, r), r)]))} target="_blank" rel="noopener nofollow sponsored">Buy</a>
                  <button class="tick" data-tick={id} aria-pressed="false" aria-label={`Mark ${m.t} as watched`}>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m4 12 6 6L20 6"/></svg>
                  </button>
                </div>
              </li>
            );
          })}
        </ol>
        </>
        ))}
        </div>
      ))}
    </div>

    {f.note && <p class="note"><strong>Worth knowing.</strong> {f.note}</p>}
    <StreamingBox f={f} />
    <p class="note-link">Think this order is wrong, or a film is missing? <a href={`/contact/?type=problem&franchise=${encodeURIComponent(f.title)}`}>Let us know</a>.</p>
    {relatedGroups.length > 0 && (
      <section class="related" aria-labelledby="related-h">
        <h2 id="related-h">Related franchises</h2>
        {relatedGroups.map(g => (
          <>
            {relatedGroups.length > 1 && <h3>{g.label}</h3>}
            <div class="grid">{g.list.map(r => <Card f={r} />)}</div>
          </>
        ))}
      </section>
    )}
  </div>

  <script is:inline define:vars={{ total: f.release.length }}>
    (function(){
      const root = document.getElementById('path');
      const slug = root.dataset.slug;
      const key = 'oom:' + slug;

      root.querySelectorAll('.toggle button').forEach(b => {
        b.addEventListener('click', () => {
          root.dataset.mode = b.dataset.set;
          root.querySelectorAll('.toggle button').forEach(x =>
            x.setAttribute('aria-pressed', String(x === b)));
        });
      });

      const read = () => { try { return JSON.parse(localStorage.getItem(key) || '[]'); } catch(e){ return []; } };
      const write = a => { try { localStorage.setItem(key, JSON.stringify(a)); } catch(e){} };

      function paint(){
        const w = read();
        root.querySelectorAll('.row').forEach(r => {
          const on = w.includes(r.dataset.id);
          r.dataset.watched = String(on);
          const t = r.querySelector('.tick');
          if(t) t.setAttribute('aria-pressed', String(on));
        });
        const done = w.length;
        const bar = root.querySelector('.progress__bar i');
        const txt = document.getElementById('progressText');
        if(bar) bar.style.width = (done / total * 100).toFixed(1) + '%';
        if(txt) txt.textContent = done + ' of ' + total + ' watched';
      }

      root.querySelectorAll('.tick').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.tick;
          let w = read();
          w = w.includes(id) ? w.filter(x => x !== id) : [...w, id];
          write(w); paint();
        });
      });

      const reset = document.getElementById('resetBtn');
      if(reset) reset.addEventListener('click', () => { write([]); paint(); });

      paint();
    })();
  </script>
</Base>
