---
/* "Stream on Disney+ · Rent or buy" under a film, for each region (CSS shows the visitor's). */
import { REGIONS, CONFIG } from '../config.js';
import { filmAvailability } from '../lib/streaming.js';
const { slug, fid, film } = Astro.props;
const lines = REGIONS.map(r => [r, filmAvailability(slug, fid, film, r)]).filter(([, a]) => a);
---
{lines.map(([r, a]) => (
  <p class="where" data-r={r}>
    {a.stream.length
      ? <>
          <span class="where__label">Stream on</span>
          {a.stream.slice(0, 3).map(s => (
            <a class="svc" href={s.href} target="_blank" rel={`noopener nofollow${s.earns ? ' sponsored' : ''}`} title={`Watch ${film.t} on ${s.name}`}>
              {s.logo && <img src={s.logo} alt="" width="18" height="18" loading="lazy" />}{s.name}
            </a>
          ))}
          {a.stream.length > 3 && <span class="where__more">+{a.stream.length - 3} more</span>}
        </>
      : <span class="where__label">Not on a subscription service in the {CONFIG.regions[r].name}{a.rentOrBuy ? ', but you can rent or buy it' : ' right now'}</span>}
  </p>
))}
