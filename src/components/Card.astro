---
import Poster from './Poster.astro';
import Title from './Title.astro';
/* cover: a poster path to show instead of the franchise's usual cover. */
const { f, cover = null } = Astro.props;
---
<a class="card" href={`/${f.slug}/`}>
  <Poster hue={f.hue} label={f.title} mark={`${f.release.length} films`} poster={cover || f.poster} />
  <h3><Title item={f} /></h3>
  <p>{f.short}</p>
</a>
