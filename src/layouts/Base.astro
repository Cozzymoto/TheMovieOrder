---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Title from '../components/Title.astro';
import { CONFIG, REGIONS } from '../config.js';
import { trending } from '../lib/franchise.js';
const popular = (await trending()).slice(0, 4);
const {
  title,
  description = 'The right order to watch every film franchise. Release order or in-universe chronology, side by side.',
  jsonld = null
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const full = title ? `${title} — The Movie Order` : 'The Movie Order — franchise watch orders';
---
<!DOCTYPE html>
<html lang="en" data-region={CONFIG.defaultRegion}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="impact-site-verification" value="35199e82-846e-4647-a7ab-96bb54c49e83">
<title>{full}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:title" content={full}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content="The Movie Order">
<meta name="twitter:card" content="summary">
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..100,400..900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
<script is:inline>
  try{ const t = localStorage.getItem('oom:theme'); if(t) document.documentElement.setAttribute('data-theme', t); }catch(e){}
  try{ const r = localStorage.getItem('oom:region'); if(r) document.documentElement.setAttribute('data-region', r); }catch(e){}
</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="masthead">
  <div class="masthead__in">
    <a class="wordmark" href="/" aria-label="The Movie Order, home"><Logo /><span><b>The Movie</b> <i>Order</i></span></a>
    <div class="search search--header" data-search id="headerSearch" role="search">
      <div class="search__field">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input class="search__input" type="search" autocomplete="off" placeholder="Search franchises" aria-label="Search franchises" role="combobox" aria-controls="headerResults" aria-expanded="false">
        <kbd class="search__key" aria-hidden="true">/</kbd>
        <button class="search__clear" hidden aria-label="Clear search">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="results" id="headerResults" role="listbox"></div>
    </div>
    <nav class="nav" aria-label="Main">
      <a href="/franchises/" aria-current={Astro.url.pathname.startsWith('/franchises') ? 'page' : undefined}>Franchises</a>
      <a href="/blog/" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>Blog</a>
      <a href="/about/" aria-current={Astro.url.pathname.startsWith('/about') ? 'page' : undefined}>About</a>
      <a href="/contact/" aria-current={Astro.url.pathname.startsWith('/contact') ? 'page' : undefined}>Contact</a>
    </nav>
    <button class="theme-btn search-btn" id="searchBtn" aria-label="Search franchises" aria-controls="headerSearch" aria-expanded="false" title="Search">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    </button>
    <button class="theme-btn" id="themeBtn" aria-label="Switch colour theme" title="Switch colour theme">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
  </div>
</header>

<main id="main" tabindex="-1"><slot /></main>

<footer class="foot">
  <div class="wrap">
    <div class="foot__cols">
      <div>
        <h4>The Movie Order</h4>
        <p style="margin:0;max-width:30ch">The right order to watch every franchise — in release order or in-universe chronology.</p>
      </div>
      <div>
        <h4>Browse</h4>
        <ul>
          <li><a href="/franchises/">All franchises</a></li>
          <li><a href="/when-order-matters/">When the order matters</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4>Popular paths</h4>
        <ul>
          {popular.map(f => <li><a href={`/${f.slug}/`}><Title item={f} /></a></li>)}
        </ul>
      </div>
    </div>
    <p class="credit">Film data and posters from <a href="https://www.themoviedb.org/" target="_blank" rel="noopener">TMDB</a>. This product uses the TMDb API but is not endorsed or certified by TMDb.</p>
    <div class="foot__legal">
      <span>&copy; {new Date().getFullYear()} The Movie Order</span>
      <span>Some links earn us a commission. It never changes what we recommend or what you pay.</span>
      <span class="region-switch" role="group" aria-label="Show links and titles for">
        Links for:
        {REGIONS.map(r => <button type="button" data-region-set={r}>{CONFIG.regions[r].name}</button>)}
      </span>
    </div>
  </div>
</footer>

<script is:inline>
  /* Every search box on the page ([data-search]): the homepage one and the
     one in the header. The franchise list is fetched once, the first time
     anyone reaches for a search box. Press / anywhere to jump to search. */
  (function(){
    const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    let index = null, loading = null;
    function load(){
      if (index) return Promise.resolve(index);
      if (!loading) loading = fetch('/search-index.json')
        .then(r => { if (!r.ok) throw new Error(); return r.json(); })
        .then(d => (index = d))
        .catch(() => { loading = null; return null; });
      return loading;
    }
    function thumb(f){
      const img = f.p ? '<img class="poster__img" src="https://image.tmdb.org/t/p/w92' + esc(f.p) + '" alt="" loading="lazy" onerror="this.remove()">' : '';
      return '<div class="poster" style="--h:' + Number(f.h) + '" aria-hidden="true"><span class="poster__t">' + esc(f.t.slice(0, 14)) + '</span>' + img + '</div>';
    }
    document.querySelectorAll('[data-search]').forEach(root => {
      const input = root.querySelector('.search__input');
      const box = root.querySelector('.results');
      const clear = root.querySelector('.search__clear');
      let active = -1;
      input.addEventListener('focus', load, { once: true });
      input.addEventListener('pointerenter', load, { once: true });
      async function run(){
        const q = input.value.trim().toLowerCase();
        clear.hidden = !q;
        root.classList.toggle('has-text', !!q);
        active = -1;
        if (!q) { box.innerHTML = ''; input.setAttribute('aria-expanded', 'false'); return; }
        input.setAttribute('aria-expanded', 'true');
        if (!index) box.innerHTML = '<p class="results__none">Searching…</p>';
        const data = await load();
        if (input.value.trim().toLowerCase() !== q) return;          // they kept typing
        if (!data) { box.innerHTML = '<p class="results__none">Search is unavailable right now. <a href="/franchises/" style="color:var(--red)">Browse every franchise</a>.</p>'; return; }
        // Franchise names that start with the search first, then names that contain it, then film titles.
        const rank = f => { const t = (f.t + ' ' + (f.a || '')).toLowerCase(); return t.startsWith(q) ? 0 : t.includes(q) ? 1 : 2; };
        const hits = data.filter(f => (f.t + ' ' + f.d + ' ' + f.k).toLowerCase().includes(q))
          .map((f, i) => [rank(f), i, f]).sort((x, y) => x[0] - y[0] || x[1] - y[1]).map(x => x[2]).slice(0, 6);
        if (!hits.length) {
          box.innerHTML = '<p class="results__none">No franchise matches that yet. <a href="/franchises/" style="color:var(--red)">Browse everything</a>.</p>';
          return;
        }
        box.innerHTML = hits.map(f =>
          '<a class="result" href="/' + esc(f.s) + '/" role="option">' + thumb(f) +
          '<span><strong>' + esc(f.t) + (f.a ? ' (' + esc(f.a) + ')' : '') + '</strong><span>' + Number(f.n) + ' films · ' + esc(f.d) + '</span></span></a>').join('');
      }
      input.addEventListener('input', run);
      clear.addEventListener('click', () => { input.value = ''; run(); input.focus(); });
      input.addEventListener('keydown', e => {
        const items = [...box.querySelectorAll('.result')];
        if ((e.key === 'ArrowDown' || e.key === 'ArrowUp') && items.length) {
          e.preventDefault();
          active = e.key === 'ArrowDown' ? (active + 1) % items.length : (active - 1 + items.length) % items.length;
          items.forEach((el, i) => el.classList.toggle('is-active', i === active));
          items[active].scrollIntoView({ block: 'nearest' });
        }
        if (e.key === 'Enter' && active > -1 && items[active]) { e.preventDefault(); items[active].click(); }
        if (e.key === 'Enter' && active === -1 && items[0]) { e.preventDefault(); items[0].click(); }
        if (e.key === 'Escape') { input.value = ''; run(); input.blur(); closeHeader(); }
      });
      document.addEventListener('click', e => { if (!root.contains(e.target)) box.innerHTML = ''; });
    });

    // On small screens the header search hides behind a button.
    const masthead = document.querySelector('.masthead');
    const btn = document.getElementById('searchBtn');
    const headerInput = document.querySelector('#headerSearch .search__input');
    function openHeader(){ masthead.classList.add('is-searching'); btn.setAttribute('aria-expanded', 'true'); headerInput.focus(); }
    function closeHeader(){ masthead.classList.remove('is-searching'); btn.setAttribute('aria-expanded', 'false'); }
    btn.addEventListener('click', () => masthead.classList.contains('is-searching') ? closeHeader() : openHeader());
    document.addEventListener('keydown', e => {
      const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName) || document.activeElement.isContentEditable;
      if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey && !e.altKey) {
        e.preventDefault();
        if (getComputedStyle(btn).display !== 'none') openHeader(); else headerInput.focus();
      }
    });
  })();
</script>

<script is:inline define:vars={{ defaultRegion: CONFIG.defaultRegion, countryRegion: { US: 'us' } }}>
  /* Region: US visitors get US links and titles, everyone else the default.
     Cloudflare's /cdn-cgi/trace says which country the visitor is in. Choosing
     a region in the footer overrides it and is remembered. */
  (function(){
    const root = document.documentElement;
    function apply(r){
      root.setAttribute('data-region', r);
      document.querySelectorAll('a[data-href-' + r + ']').forEach(a => { a.href = a.getAttribute('data-href-' + r); });
      document.querySelectorAll('[data-region-set]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.regionSet === r)));
    }
    let saved = null, chosen = null;
    try { saved = localStorage.getItem('oom:region'); chosen = localStorage.getItem('oom:region-chosen'); } catch(e){}
    apply(saved || defaultRegion);
    if (!chosen) {
      fetch('/cdn-cgi/trace').then(r => r.ok ? r.text() : '').then(t => {
        const m = t.match(/^loc=([A-Z]{2})$/m);
        const r = (m && countryRegion[m[1]]) || defaultRegion;
        apply(r);
        try { localStorage.setItem('oom:region', r); } catch(e){}
      }).catch(() => {});
    }
    document.querySelectorAll('[data-region-set]').forEach(b => b.addEventListener('click', () => {
      apply(b.dataset.regionSet);
      try { localStorage.setItem('oom:region', b.dataset.regionSet); localStorage.setItem('oom:region-chosen', '1'); } catch(e){}
    }));
  })();
</script>

<script is:inline>
  document.getElementById('themeBtn').addEventListener('click', () => {
    const dark = matchMedia('(prefers-color-scheme: dark)').matches;
    const cur = document.documentElement.getAttribute('data-theme') || (dark ? 'dark' : 'light');
    const next = cur === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try{ localStorage.setItem('oom:theme', next); }catch(e){}
  });
</script>
</body>
</html>
